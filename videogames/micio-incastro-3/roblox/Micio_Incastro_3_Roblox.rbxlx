      <Item class="ModuleScript" referent="RBX00000012">
        <Properties>
          <string name="Name">Journey</string>
          <ProtectedString name="Source">-- Generated from ../journey.js. Coordinates are zero-based, exactly as in the web game.
return {["WORLDS"]={{["name"]="Venezia",["country"]="Italia",["region"]="Europa",["asset"]="italia",["symbol"]="◈",["caption"]="Canali, ponti e riflessi color miele."},{["name"]="Parigi",["country"]="Francia",["region"]="Europa",["asset"]="francia",["symbol"]="✧",["caption"]="Una passeggiata luminosa lungo la Senna."},{["name"]="Barcellona",["country"]="Spagna",["region"]="Europa",["asset"]="spagna",["symbol"]="✺",["caption"]="Mosaici, giardini e meraviglie di Gaudí."},{["name"]="Londra",["country"]="Inghilterra",["region"]="Europa",["asset"]="inghilterra",["symbol"]="♜",["caption"]="Torri e ponti sulle acque del Tamigi."},{["name"]="Agra",["country"]="India",["region"]="Asia",["asset"]="india",["symbol"]="❋",["caption"]="Il Taj Mahal si specchia nel suo giardino."},{["name"]="La Grande Muraglia",["country"]="Cina",["region"]="Asia",["asset"]="cina",["symbol"]="⌁",["caption"]="Un sentiero che abbraccia le montagne."},{["name"]="Kyoto",["country"]="Giappone",["region"]="Asia",["asset"]="giappone",["symbol"]="❀",["caption"]="Pagode e petali nel vento di primavera."},{["name"]="Bangkok",["country"]="Thailandia",["region"]="Asia",["asset"]="thailandia",["symbol"]="✦",["caption"]="Templi dorati sulle rive del fiume."},{["name"]="New York",["country"]="Stati Uniti",["region"]="America del Nord",["asset"]="new-york",["symbol"]="▥",["caption"]="Ponti, grattacieli e una città piena di luce."},{["name"]="Chicago",["country"]="Stati Uniti",["region"]="America del Nord",["asset"]="chicago",["symbol"]="▦",["caption"]="Il fiume attraversa un giardino di torri."},{["name"]="Città di Panama",["country"]="Panama",["region"]="America Centrale",["asset"]="panama",["symbol"]="≈",["caption"]="Case colorate e nuovi orizzonti sulla baia."},{["name"]="Rio de Janeiro",["country"]="Brasile",["region"]="America del Sud",["asset"]="brasile",["symbol"]="☀",["caption"]="Montagne, spiagge e un tramonto tropicale."},{["name"]="Patagonia",["country"]="Argentina",["region"]="America del Sud",["asset"]="argentina",["symbol"]="△",["caption"]="Picchi, ghiacciai e laghi color turchese."},{["name"]="Giza",["country"]="Egitto",["region"]="Africa",["asset"]="egitto",["symbol"]="▲",["caption"]="Piramidi e oasi nella luce del deserto."},{["name"]="Amboseli",["country"]="Kenya",["region"]="Africa",["asset"]="kenya",["symbol"]="♧",["caption"]="Acacie nella savana, sotto un cielo immenso."},{["name"]="Sydney",["country"]="Australia",["region"]="Oceania",["asset"]="australia",["symbol"]="◒",["caption"]="Vele bianche e riflessi nel porto."},{["name"]="Fiordland",["country"]="Nuova Zelanda",["region"]="Oceania",["asset"]="nuova-zelanda",["symbol"]="❧",["caption"]="Fiordi e foreste dalle mille sfumature di verde."},{["name"]="L’ultimo orizzonte",["country"]="Antartide",["region"]="Antartide",["asset"]="antartide",["symbol"]="❄",["caption"]="Ghiaccio, pinguini e il silenzio delle stelle."}},["MISSIONS"]={{["world"]=0,["kind"]="figure",["label"]="Diamante",["targets"]={{["x"]=4,["y"]=8},{["x"]=3,["y"]=9},{["x"]=4,["y"]=9},{["x"]=5,["y"]=9},{["x"]=3,["y"]=10},{["x"]=4,["y"]=10},{["x"]=5,["y"]=10},{["x"]=4,["y"]=11}},["title"]="Diamante",["duration"]=210000},{["world"]=0,["kind"]="figure",["label"]="Barchetta",["targets"]={{["x"]=4,["y"]=8},{["x"]=4,["y"]=9},{["x"]=2,["y"]=10},{["x"]=3,["y"]=10},{["x"]=4,["y"]=10},{["x"]=5,["y"]=10},{["x"]=6,["y"]=10},{["x"]=3,["y"]=11},{["x"]=4,["y"]=11},{["x"]=5,["y"]=11}},["title"]="Barchetta",["duration"]=210000},{["world"]=1,["kind"]="figure",["label"]="Freccia",["targets"]={{["x"]=4,["y"]=6},{["x"]=3,["y"]=7},{["x"]=4,["y"]=7},{["x"]=5,["y"]=7},{["x"]=2,["y"]=8},{["x"]=3,["y"]=8},{["x"]=4,["y"]=8},{["x"]=5,["y"]=8},{["x"]=6,["y"]=8},{["x"]=4,["y"]=9},{["x"]=4,["y"]=10},{["x"]=4,["y"]=11}},["title"]="Freccia",["duration"]=210000},{["world"]=1,["kind"]="figure",["label"]="Cuoricino",["targets"]={{["x"]=2,["y"]=8},{["x"]=3,["y"]=8},{["x"]=5,["y"]=8},{["x"]=6,["y"]=8},{["x"]=2,["y"]=9},{["x"]=3,["y"]=9},{["x"]=4,["y"]=9},{["x"]=5,["y"]=9},{["x"