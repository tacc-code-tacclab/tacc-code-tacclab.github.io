8},{["x"]=3,["y"]=8},{["x"]=4,["y"]=8},{["x"]=5,["y"]=8},{["x"]=6,["y"]=8},{["x"]=7,["y"]=8},{["x"]=2,["y"]=9},{["x"]=3,["y"]=9},{["x"]=4,["y"]=9},{["x"]=5,["y"]=9},{["x"]=6,["y"]=9},{["x"]=2,["y"]=10},{["x"]=3,["y"]=10},{["x"]=4,["y"]=10},{["x"]=5,["y"]=10},{["x"]=6,["y"]=10},{["x"]=3,["y"]=11},{["x"]=4,["y"]=11},{["x"]=5,["y"]=11}},["title"]="Grande cuore",["duration"]=285000},{["world"]=17,["kind"]="figure",["label"]="Conchiglia",["targets"]={{["x"]=4,["y"]=4},{["x"]=3,["y"]=5},{["x"]=4,["y"]=5},{["x"]=5,["y"]=5},{["x"]=2,["y"]=6},{["x"]=3,["y"]=6},{["x"]=4,["y"]=6},{["x"]=5,["y"]=6},{["x"]=6,["y"]=6},{["x"]=1,["y"]=7},{["x"]=2,["y"]=7},{["x"]=3,["y"]=7},{["x"]=4,["y"]=7},{["x"]=5,["y"]=7},{["x"]=6,["y"]=7},{["x"]=7,["y"]=7},{["x"]=1,["y"]=8},{["x"]=2,["y"]=8},{["x"]=3,["y"]=8},{["x"]=4,["y"]=8},{["x"]=5,["y"]=8},{["x"]=6,["y"]=8},{["x"]=7,["y"]=8},{["x"]=1,["y"]=9},{["x"]=2,["y"]=9},{["x"]=3,["y"]=9},{["x"]=4,["y"]=9},{["x"]=5,["y"]=9},{["x"]=6,["y"]=9},{["x"]=7,["y"]=9},{["x"]=2,["y"]=10},{["x"]=3,["y"]=10},{["x"]=4,["y"]=10},{["x"]=5,["y"]=10},{["x"]=6,["y"]=10},{["x"]=3,["y"]=11},{["x"]=4,["y"]=11},{["x"]=5,["y"]=11}},["title"]="Conchiglia",["duration"]=285000},{["world"]=17,["kind"]="figure",["label"]="Il mondo dei mici",["targets"]={{["x"]=1,["y"]=4},{["x"]=2,["y"]=4},{["x"]=6,["y"]=4},{["x"]=7,["y"]=4},{["x"]=1,["y"]=5},{["x"]=2,["y"]=5},{["x"]=3,["y"]=5},{["x"]=5,["y"]=5},{["x"]=6,["y"]=5},{["x"]=7,["y"]=5},{["x"]=1,["y"]=6},{["x"]=2,["y"]=6},{["x"]=3,["y"]=6},{["x"]=4,["y"]=6},{["x"]=5,["y"]=6},{["x"]=6,["y"]=6},{["x"]=7,["y"]=6},{["x"]=1,["y"]=7},{["x"]=2,["y"]=7},{["x"]=3,["y"]=7},{["x"]=4,["y"]=7},{["x"]=5,["y"]=7},{["x"]=6,["y"]=7},{["x"]=7,["y"]=7},{["x"]=1,["y"]=8},{["x"]=2,["y"]=8},{["x"]=3,["y"]=8},{["x"]=4,["y"]=8},{["x"]=5,["y"]=8},{["x"]=6,["y"]=8},{["x"]=7,["y"]=8},{["x"]=2,["y"]=9},{["x"]=3,["y"]=9},{["x"]=4,["y"]=9},{["x"]=5,["y"]=9},{["x"]=6,["y"]=9},{["x"]=2,["y"]=10},{["x"]=3,["y"]=10},{["x"]=4,["y"]=10},{["x"]=5,["y"]=10},{["x"]=6,["y"]